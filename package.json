{
  "name": "dsh-pet-task-ctl",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "dsh-pet Agent bridge: chat-command task controller + shared long-term memory for DSH (no upstream patch)",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-pet",
    "deepseek-harness",
    "desktop-pet",
    "agent"
  ],
  "bin": {
    "dsh-pet-patch": "scripts/patch-dsh-pet.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts/patch-dsh-pet.mjs",
    "scripts/postinstall.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  }
}